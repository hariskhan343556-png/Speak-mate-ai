# Copy this file to .env and fill in your own values.

# Required for transcription and AI feedback.
OPENAI_API_KEY=your_api_key_here

# Optional: point at any OpenAI-compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional model overrides.
SPEAKMATE_CHAT_MODEL=gpt-4o-mini
SPEAKMATE_STT_MODEL=whisper-1

# Optional tuning.
SPEAKMATE_DB_URL=sqlite:///data/speakmate.db
SPEAKMATE_FREE_DAILY_ANALYSES=5
SPEAKMATE_MAX_TRANSCRIPT_CHARS=1800
SPEAKMATE_MAX_AUDIO_MB=12

# Created on first run if it does not exist yet.
SPEAKMATE_ADMIN_EMAIL=admin@speakmate.local
SPEAKMATE_ADMIN_PASSWORD=ChangeMe123!
